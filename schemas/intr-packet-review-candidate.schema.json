{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/intr-packet-review-candidate.schema.json",
  "type": "object",
  "required": ["schema","status","protocol","topology_ref","envelope","hop_state_machine","endpoint_resolution_state_machine","failure_invariants"],
  "properties": {
    "schema": {"const": "stegverse.intr.packet.review_candidate/v1"},
    "status": {"const": "REVIEW_CANDIDATE"},
    "protocol": {"const": "InTr"},
    "topology_ref": {"type": "string"},
    "envelope": {
      "type": "object",
      "required": ["packet_id","packet_version","direction","source_role","next_role","final_role","operation_hash","payload_hash","issued_at","expires_at","nonce","replay","authority","boundary_proof","protected_payload","credential_grant","receipt_policy"],
      "properties": {
        "packet_id": {"type": "string","minLength": 1},
        "packet_version": {"type": "integer","minimum": 1},
        "direction": {"enum": ["FORWARD","RETURN"]},
        "source_role": {"enum": ["SKAP","KV","DEVICE","EXTERNAL_NETWORK","ENDPOINT"]},
        "next_role": {"enum": ["SKAP","KV","DEVICE","EXTERNAL_NETWORK","ENDPOINT"]},
        "final_role": {"enum": ["SKAP","KV","DEVICE","EXTERNAL_NETWORK","ENDPOINT"]},
        "operation_hash": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"},
        "payload_hash": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"},
        "prior_receipt_hash": {"type": ["string","null"]},
        "issued_at": {"type": "string"},
        "expires_at": {"type": "string"},
        "nonce": {"type": "string","minLength": 1},
        "replay": {
          "type": "object",
          "required": ["max_uses","use_index","state"],
          "properties": {
            "max_uses": {"type": "integer","minimum": 1},
            "use_index": {"type": "integer","minimum": 0},
            "state": {"enum": ["ISSUED","CLAIMED","CONSUMED","REJECTED"]}
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": ["authority_transfer","model_output_grants_execution_authority","transport_grants_execution_authority"],
          "properties": {
            "authority_transfer": {"const": false},
            "model_output_grants_execution_authority": {"const": false},
            "transport_grants_execution_authority": {"const": false}
          },
          "additionalProperties": false
        },
        "boundary_proof": {
          "type": "object",
          "required": ["required","source_identity_ref","next_boundary_identity_ref","verification_state"],
          "properties": {
            "required": {"const": true},
            "source_identity_ref": {"type": "string","minLength": 1},
            "next_boundary_identity_ref": {"type": "string","minLength": 1},
            "verification_state": {"enum": ["PENDING","VERIFIED","FAILED"]}
          },
          "additionalProperties": false
        },
        "protected_payload": {
          "type": "object",
          "required": ["sealed","plaintext_present","content_class","sealed_material_ref","resolution_policy"],
          "properties": {
            "sealed": {"const": true},
            "plaintext_present": {"const": false},
            "content_class": {"enum": ["SKAP_CREDENTIAL_GRANT","GENERIC_SEALED_PAYLOAD"]},
            "sealed_material_ref": {"type": "string","minLength": 1},
            "resolution_policy": {"const": "ENDPOINT_SESSION_VERIFIED_AND_GRANT_VALID"}
          },
          "additionalProperties": false
        },
        "credential_grant": {
          "type": "object",
          "required": ["credential_ref","credential_version","purpose","authorized_endpoint","authorized_resolver_ref","maximum_calls","revocation_check_required_immediately_before_resolution","same_authenticated_session_required_for_resolution_and_submission"],
          "properties": {
            "credential_ref": {"type": "string","pattern": "^skap://"},
            "credential_version": {"type": "integer","minimum": 1},
            "purpose": {"type": "string","minLength": 1},
            "authorized_endpoint": {
              "type": "object",
              "required": ["service_id","host","scheme","port","path_prefix"],
              "properties": {
                "service_id": {"type": "string","minLength": 1},
                "host": {"type": "string","minLength": 1},
                "scheme": {"const": "https"},
                "port": {"type": "integer","minimum": 1,"maximum": 65535},
                "path_prefix": {"type": "string","pattern": "^/"}
              },
              "additionalProperties": false
            },
            "authorized_resolver_ref": {"type": "string","minLength": 1},
            "maximum_calls": {"type": "integer","minimum": 1},
            "maximum_cost": {"type": ["number","null"],"minimum": 0},
            "revocation_check_required_immediately_before_resolution": {"const": true},
            "same_authenticated_session_required_for_resolution_and_submission": {"const": true}
          },
          "additionalProperties": false
        },
        "receipt_policy": {
          "type": "object",
          "required": ["receipt_required_each_hop","receipt_contains_secret_plaintext","receipt_chain_required","ambiguous_submission_disposition"],
          "properties": {
            "receipt_required_each_hop": {"const": true},
            "receipt_contains_secret_plaintext": {"const": false},
            "receipt_chain_required": {"const": true},
            "ambiguous_submission_disposition": {"const": "VERIFY_EXTERNALLY"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
