{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/kv-interlock-response.schema.json",
  "title": "KnowledgeVault Interlock Response",
  "description": "Canonical model-neutral response contract for KV-INTERLOCK-v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "decision",
    "granted_scope",
    "context",
    "source_refs",
    "receipt"
  ],
  "properties": {
    "schema_version": {"const": "kv.interlock.response.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ALLOW_BOUNDED_CONTEXT", "REVIEW_REQUIRED", "DENY", "FAIL_CLOSED"]},
    "granted_scope": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "description": "Bounded context only. A consumer must reject fields outside granted_scope."
    },
    "source_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "kv_access_receipt": {
      "type": "object",
      "description": "Layer 1 (StegVerse-Labs/.github#3330 rev 1, LC-KV-03/10): the KV-access receipt that KVInterlockRuntime.handle (INTR_DEVICE_KV) mints for a requester that the pinned InTr healthy-node evaluator admits as currently healthy. Only on ALLOW_BOUNDED_CONTEXT. The layer-2 SKAP gate (INTR_KV_SKAP) accepts only its receipt_hash as prior_receipt_hash. A layer-1 refusal is a six-field FAIL_CLOSED disposition (failure_code KV_ACCESS_LAYER1_REFUSED) and carries no receipt.",
      "required": ["schema", "boundary", "layer", "receipt_hash", "requester_node_ref", "healthy_node_receipt"],
      "properties": {
        "schema": {"const": "stegverse.kv-access-receipt/v1"},
        "boundary": {"const": "INTR_DEVICE_KV"},
        "layer": {"const": 1},
        "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "policy_profile",
        "authority_ref",
        "requested_scope",
        "granted_scope",
        "decision",
        "timestamp",
        "response_hash"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "policy_profile": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "minLength": 1},
        "requested_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "granted_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "redaction_profile": {"type": ["string", "null"]},
        "decision": {"enum": ["ALLOW_BOUNDED_CONTEXT", "REVIEW_REQUIRED", "DENY", "FAIL_CLOSED"]},
        "timestamp": {"type": "string", "minLength": 1},
        "response_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "writeback_candidate_ref": {"type": ["string", "null"]}
      }
    }
  }
}
