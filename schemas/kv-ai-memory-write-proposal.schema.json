{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/kv-ai-memory-write-proposal.schema.json",
  "title": "KnowledgeVault AI memory write proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "proposal_id", "source_packet_id", "target_kv_class", "target_authority_domain",
    "target_kv_instance_id", "relative_path", "content", "content_sha256", "retention_class",
    "intr_admission_required", "execution_authorized", "model_is_authority", "authority_effect"
  ],
  "properties": {
    "schema": {"const": "stegverse.kv.ai-memory-write-proposal/v1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "source_packet_id": {"type": "string", "minLength": 1},
    "target_kv_class": {"enum": ["PERSONAL_KV", "ORGANIZATIONAL_KV", "STEGVERSE_KV", "MACHINE_KV"]},
    "target_authority_domain": {"enum": ["PERSON", "ORGANIZATION", "STEGVERSE_ECOSYSTEM", "MACHINE_EXECUTION_ENTITY"]},
    "target_kv_instance_id": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retention_class": {"enum": ["SESSION", "PROJECT", "DURABLE"]},
    "intr_admission_required": {"const": true},
    "execution_authorized": {"const": false},
    "model_is_authority": {"const": false},
    "authority_effect": {"const": "NONE_PROPOSAL_ONLY"}
  }
}