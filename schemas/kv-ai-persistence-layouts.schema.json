{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/kv-ai-persistence-layouts.schema.json",
  "title": "StegVerse concrete KV AI persistence layouts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "layouts", "shared_invariants"],
  "properties": {
    "schema": {"const": "stegverse.kv.ai-persistence-layouts/v1"},
    "layouts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kv_class", "authority_domain", "ai_role", "root", "state_domains", "receipt_root", "capability_ref_root", "direct_cross_class_mutation", "provider_is_authority", "model_is_authority"],
        "properties": {
          "kv_class": {"enum": ["PERSONAL_KV", "ORGANIZATIONAL_KV", "STEGVERSE_KV", "MACHINE_KV"]},
          "authority_domain": {"enum": ["PERSON", "ORGANIZATION", "STEGVERSE_ECOSYSTEM", "MACHINE_EXECUTION_ENTITY"]},
          "ai_role": {"enum": ["PERSONAL_ASSISTANT_AI", "ORGANIZATIONAL_AI", "STEGVERSE_AI", "EXECUTION_AGENT"]},
          "root": {"type": "string", "minLength": 1},
          "state_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "relative_path", "purpose", "mutable_only_after_intr_admission"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "relative_path": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "mutable_only_after_intr_admission": {"const": true}
              }
            }
          },
          "receipt_root": {"type": "string", "minLength": 1},
          "capability_ref_root": {"type": "string", "minLength": 1},
          "direct_cross_class_mutation": {"const": false},
          "provider_is_authority": {"const": false},
          "model_is_authority": {"const": false}
        }
      }
    },
    "shared_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skap_required", "intr_required", "cross_class_receipt_required", "least_authority", "fail_closed_on_ambiguous_scope"],
      "properties": {
        "skap_required": {"const": true},
        "intr_required": {"const": true},
        "cross_class_receipt_required": {"const": true},
        "least_authority": {"const": true},
        "fail_closed_on_ambiguous_scope": {"const": true}
      }
    }
  }
}
