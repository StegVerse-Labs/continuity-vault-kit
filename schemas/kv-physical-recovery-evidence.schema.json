{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stegverse.org/schemas/kv-physical-recovery-evidence.schema.json",
  "title":"KnowledgeVault Physical Cross-Platform Recovery Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","experiment_id","kv_id","provider","provider_access","old_device","new_device","recovery_authority","continuity","transport","key_provisioning","final_receipt"],
  "properties":{
    "schema":{"const":"stegverse.kv.physical-recovery-evidence/v1"},
    "experiment_id":{"type":"string","minLength":1},
    "kv_id":{"type":"string","minLength":1},
    "provider":{"type":"string","minLength":1},
    "provider_access":{"type":"object","additionalProperties":false,"required":["mode","encrypted_package_acquired","provider_auth_exposes_usable_kv"],"properties":{
      "mode":{"const":"BROWSER_ONLY"},
      "encrypted_package_acquired":{"type":"boolean"},
      "provider_auth_exposes_usable_kv":{"const":false}
    }},
    "old_device":{"type":"object","additionalProperties":false,"required":["device_id","status_before","status_after","unavailable_observed"],"properties":{
      "device_id":{"type":"string","minLength":1},
      "status_before":{"enum":["CONFIRMED","LOST","LOST_REVOKED","REVOKED"]},
      "status_after":{"enum":["LOST","LOST_REVOKED","REVOKED"]},
      "unavailable_observed":{"type":"boolean"}
    }},
    "new_device":{"type":"object","additionalProperties":false,"required":["device_id","platform","distinct_identity","registration_observed","attestation_ref"],"properties":{
      "device_id":{"type":"string","minLength":1},
      "platform":{"type":"string","minLength":1},
      "distinct_identity":{"type":"boolean"},
      "registration_observed":{"type":"boolean"},
      "attestation_ref":{"type":"string","minLength":1}
    }},
    "recovery_authority":{"type":"object","additionalProperties":false,"required":["verified","independent_of_provider_auth","evidence_ref"],"properties":{
      "verified":{"type":"boolean"},
      "independent_of_provider_auth":{"type":"boolean"},
      "evidence_ref":{"type":"string","minLength":1}
    }},
    "continuity":{"type":"object","additionalProperties":false,"required":["root_before","root_after","kv_identity_preserved"],"properties":{
      "root_before":{"pattern":"^[a-f0-9]{64}$"},
      "root_after":{"pattern":"^[a-f0-9]{64}$"},
      "kv_identity_preserved":{"type":"boolean"}
    }},
    "transport":{"type":"object","additionalProperties":false,"required":["protocol","interlock_observed","intr_packet_ref","intr_receipt_ref"],"properties":{
      "protocol":{"const":"InTr"},
      "interlock_observed":{"type":"boolean"},
      "intr_packet_ref":{"type":"string","minLength":1},
      "intr_receipt_ref":{"type":"string","minLength":1}
    }},
    "key_provisioning":{"type":"object","additionalProperties":false,"required":["mode","observed","old_device_key_reused"],"properties":{
      "mode":{"enum":["REWRAP","DERIVE_BOUNDED","OTHER_GOVERNED"]},
      "observed":{"type":"boolean"},
      "old_device_key_reused":{"const":false}
    }},
    "final_receipt":{"type":"object","additionalProperties":false,"required":["receipt_ref","receipt_sha256"],"properties":{
      "receipt_ref":{"type":"string","minLength":1},
      "receipt_sha256":{"pattern":"^[a-f0-9]{64}$"}
    }}
  }
}