{
  "schema_version": "0.1",
  "delegation_id": "standing-private-family-posts-001",
  "principal": {"entity_id": "user:owner", "entity_type": "user"},
  "delegate": {"entity_id": "auri:primary", "entity_type": "governed_ai"},
  "authority_source": "standing_delegation",
  "purpose": "Publish user-selected family photos to the private family group without repetitive confirmation",
  "scope": {
    "actions": ["publish_post"],
    "resources": ["photo:user_selected", "caption:user_supplied"],
    "destinations": ["facebook:private-family-group"],
    "constraints": {"visibility": "private_group", "max_posts_per_day": 5},
    "exclusions": ["public_timeline", "facial_identification", "location_tagging"]
  },
  "validity": {
    "starts_at": "2026-07-15T21:10:00Z",
    "expires_at": "2027-07-15T21:10:00Z",
    "revocable": true,
    "revoked_at": null,
    "revocation_reason": null
  },
  "confirmation_policy": "confirm_on_material_change",
  "escalation_rules": [
    {"rule_id": "public-visibility", "condition": "requested visibility is public", "decision": "ASK"},
    {"rule_id": "location-tag", "condition": "request adds a location tag", "decision": "ASK"}
  ],
  "receipt_policy": {
    "required": true,
    "events": ["delegation_created", "action_authorized", "action_completed", "action_failed", "escalation_requested", "delegation_revised", "delegation_revoked", "delegation_expired"],
    "integrity_algorithm": "sha256"
  },
  "status": "active",
  "relationship_declaration_ref": "relationship:user-owner:auri-primary"
}
