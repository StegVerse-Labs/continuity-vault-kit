{
  "schema_version": "0.1",
  "delegation_id": "direct-facebook-post-001",
  "principal": {"entity_id": "user:owner", "entity_type": "user"},
  "delegate": {"entity_id": "auri:primary", "entity_type": "governed_ai"},
  "authority_source": "direct_instruction",
  "purpose": "Publish the selected photo with the supplied caption",
  "scope": {
    "actions": ["publish_post"],
    "resources": ["photo:current_capture", "caption:good-times"],
    "destinations": ["facebook:owner-account"],
    "constraints": {"caption_exact": "Good times!"},
    "exclusions": ["additional_media", "additional_recipients"]
  },
  "validity": {
    "starts_at": "2026-07-15T21:10:00Z",
    "expires_at": "2026-07-15T22:10:00Z",
    "revocable": true,
    "revoked_at": null,
    "revocation_reason": null
  },
  "confirmation_policy": "execute_when_covered",
  "escalation_rules": [
    {"rule_id": "destination-change", "condition": "destination differs from facebook:owner-account", "decision": "ASK"}
  ],
  "receipt_policy": {
    "required": true,
    "events": ["action_authorized", "action_completed", "action_failed", "escalation_requested"],
    "integrity_algorithm": "sha256"
  },
  "status": "active",
  "relationship_declaration_ref": "relationship:user-owner:auri-primary"
}
