{
  "schema":"stegverse.kv.cross-platform-recovery-cases/v1",
  "cases":[
    {
      "case_id":"IPHONE_ICLOUD_TO_SAMSUNG_BROWSER",
      "expected":"ALLOW_WITH_SIGNOFF",
      "package":{
        "schema":"stegverse.kv.cross-platform-recovery-package/v1",
        "kv_id":"kv-test-001",
        "provider":"iCloud",
        "access_mode":"BROWSER_ONLY",
        "package_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "expected_package_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "continuity_root":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "current_continuity_root":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "old_device":{"device_id":"iphone-A","status":"LOST_REVOKED"},
        "new_device":{"device_id":"samsung-B","claims_old_device_identity":false},
        "recovery":{"cloud_account_authenticated":true,"recovery_authority_verified":true,"old_device_unavailable":true,"browser_execution_requested":false},
        "transport":{"protocol":"InTr","interlock_verified":true,"intr_bound":true,"cloud_account_is_kv_authority":false}
      }
    },
    {
      "case_id":"CLOUD_LOGIN_ONLY",
      "expected":"DENY",
      "mutate":{"recovery.recovery_authority_verified":false}
    },
    {
      "case_id":"TAMPERED_PACKAGE",
      "expected":"FAIL_CLOSED",
      "mutate":{"package_sha256":"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"}
    },
    {
      "case_id":"STALE_CONTINUITY_ROOT",
      "expected":"ESCALATE",
      "mutate":{"continuity_root":"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}
    },
    {
      "case_id":"OLD_DEVICE_ID_REUSE",
      "expected":"FAIL_CLOSED",
      "mutate":{"new_device.device_id":"iphone-A","new_device.claims_old_device_identity":true}
    },
    {
      "case_id":"BROWSER_EXECUTION_ATTEMPT",
      "expected":"DENY",
      "mutate":{"recovery.browser_execution_requested":true}
    },
    {
      "case_id":"MISSING_INTR_BINDING",
      "expected":"FAIL_CLOSED",
      "mutate":{"transport.intr_bound":false}
    }
  ]
}